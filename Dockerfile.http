# The hosted MCP endpoint (Streamable HTTP) for mcp.aimentiontracker.ai.
#
# Built from the SAME package as the published @aimentiontracker/mcp stdio
# binary: one tools layer, two transports (src/index.ts = stdio for local
# clients, src/http.ts = this). A tool that behaves differently depending on how
# it was reached is a support case nobody can reproduce.
#
# THIS IMAGE TAKES NO SECRETS AND MUST NEVER BE GIVEN ANY. No env_file, no
# DATABASE_URL, no vendor key. The caller's API key arrives in the
# Authorization header per request and is passed straight through to the API,
# which owns auth, tenancy, entitlement and rate limiting.
FROM node:22-alpine AS build
WORKDIR /srv
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npx tsc -p tsconfig.json

FROM node:22-alpine
WORKDIR /srv
ENV NODE_ENV=production
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /srv/dist ./dist
# Unprivileged, because this process is reachable from the public internet and
# has no reason to own anything on disk.
USER node
EXPOSE 3210
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3210/healthz || exit 1
CMD ["node", "dist/http.js"]
